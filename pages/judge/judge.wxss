/* access gate */
.gate {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  text-align: center;
}
.gate-icon {
  font-size: 110rpx;
}
.gate-title {
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 20rpx;
}
.gate-text {
  margin-top: 16rpx;
  max-width: 520rpx;
}
.gate-btn {
  margin-top: 40rpx;
  width: 60%;
}

/* logged-in judge banner */
.judge-banner {
  display: flex;
  align-items: center;
  background: #eef0fb;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
}
.judge-banner-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}
.judge-banner-text {
  font-size: 26rpx;
  color: #5b5bd6;
  font-weight: 600;
}

.header {
  background: linear-gradient(135deg, #5b5bd6, #8a6ef0);
  color: #fff;
}
.h-name {
  font-size: 38rpx;
  font-weight: 700;
}
.h-song {
  margin-top: 8rpx;
  font-size: 28rpx;
  opacity: 0.95;
}
.h-final {
  margin-top: 16rpx;
  font-size: 26rpx;
}
.h-final-num {
  font-size: 40rpx;
  font-weight: 700;
  margin: 0 8rpx;
}
.h-final-sub {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.judges {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.judge-chip {
  flex: 1;
  min-width: 110rpx;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 20rpx;
  background: #f4f5fb;
  border: 2rpx solid transparent;
}
.judge-chip.scored {
  background: #e6f7ee;
}
.judge-chip.mine {
  border-color: #5b5bd6;
  background: #eef0fb;
}
.overview-note {
  margin-top: 18rpx;
  font-size: 22rpx;
}
.jc-label {
  font-size: 28rpx;
  font-weight: 600;
}
.jc-sub {
  font-size: 22rpx;
  color: #9aa0b0;
  margin-top: 4rpx;
}

.dim {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f1f2f8;
}
.dim-head {
  flex: 1;
}
.dim-label {
  font-size: 28rpx;
  font-weight: 600;
}
.dim-max {
  font-size: 24rpx;
  color: #b0b4c2;
  margin-left: 10rpx;
}
.dim-input {
  width: 160rpx;
  background: #f4f5fb;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}
.dim-input.locked {
  background: #f1f2f8;
  color: #9aa0b0;
}

.locked-tag {
  font-size: 22rpx;
  color: #1a9b58;
  background: #e6f7ee;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 14rpx;
  font-weight: 600;
}
.submitted-box {
  background: #e6f7ee;
  color: #1a9b58;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 30rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}
.total-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #5b5bd6;
}
.lock-note {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
}
