.login-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #5b5bd6, #8a6ef0);
  color: #fff;
  padding: 28rpx 32rpx;
}
.lh-title {
  font-size: 32rpx;
  font-weight: 700;
}
.login-hint .muted {
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}
.lh-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.9);
}

.form-item {
  margin-bottom: 30rpx;
}
.form-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
  display: block;
}
.form-label .req {
  color: #ff7a59;
  margin-left: 6rpx;
}
.input {
  background: #f4f5fb;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  font-size: 28rpx;
}
.use-name {
  font-size: 24rpx;
  color: #5b5bd6;
  margin-top: 12rpx;
}
.picker {
  background: #f4f5fb;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  font-size: 28rpx;
  color: #1f2430;
}
.picker.placeholder {
  color: #b0b4c2;
}
.textarea {
  background: #f4f5fb;
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  height: 150rpx;
}
.submit {
  margin-top: 16rpx;
}
.counter {
  text-align: right;
  font-size: 22rpx;
  color: #b0b4c2;
  margin-top: 8rpx;
}
